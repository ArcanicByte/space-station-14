paper-ui-language-label = Language:
paper-ui-translate-button = Translate
paper-ui-translate-tooltip = Rewrite everything you can edit on this paper in the selected language.
paper-ui-no-written-language = You don't speak any written languages.
paper-ui-locked-warning = ⚠ Writing in a language you can't write (marked with an id) is erased if you change any of it.

paper-language-converted = You don't know how to write {$languages}, so you wrote it in {$language} instead.
paper-language-dropped = You scribble on the paper, but none of it means anything.
paper-language-erased = { $count ->
    [one] You scribbled over some writing in a language you can't write. It's gone now.
   *[other] You scribbled over {$count} pieces of writing in languages you can't write. They're gone now.
}
paper-language-removed = { $count ->
    [one] You erased some writing in a language you can't write.
   *[other] You erased {$count} pieces of writing in languages you can't write.
}
paper-save-cooldown = You need a moment before writing on this again.
infernal-contract-examined-unreadable = You are unsure what this contract has to offer.
paper-language-cannot-write = You don't know how to write anymore, so you put the pen down.
paper-ui-close-button = Close
paper-ui-cannot-save-warning = ⚠ You don't know any written languages, so your changes can't be saved.
paper-ui-lost-language-warning = ⚠ You can no longer write {$languages}. Anything you changed in it will be written in {$language} when you save.
paper-form-no-language = You don't know any written languages, so you can't fill this in.
paper-form-changed = The paper changed, try again.
paper-full = There's no room left on the paper.
